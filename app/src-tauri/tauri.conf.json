{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Xray",
  "version": "0.0.1",
  "identifier": "dev.xray.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Xray",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "deb", "appimage", "dmg"],
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [],
    "category": "DeveloperTool",
    "shortDescription": "Backend protocol inspector",
    "longDescription": "Xray inspects, diffs, and replays requests across HTTP, Redis, DNS and more."
  },
  "plugins": {}
}
